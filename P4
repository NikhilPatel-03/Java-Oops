
class Calculator {

    int add(int a, int b) {
        return a + b;
    }

    int add(int a, int b, int c) {
        return a + b + c;
    }

    double add(double a, double b) {
        return a + b;
    }
}

class Employee {

    double calculatePay() {
        return 0;
    }
}

class FullTimeEmployee extends Employee {

    double calculatePay() {
        return 30000;
    }
}

class PartTimeEmployee extends Employee {

    double calculatePay() {
        return 15000;
    }
}

public class Practical4 {

    public static void main(String[] args) {

        Calculator cal = new Calculator();

        System.out.println("Method Overloading");

        System.out.println("Addition of two numbers: " + cal.add(10, 20));
        System.out.println("Addition of three numbers: " + cal.add(10, 20, 30));
        System.out.println("Addition of decimal numbers: " + cal.add(10.5, 20.5));

        System.out.println();

        System.out.println("Method Overriding");

        Employee emp;

        emp = new FullTimeEmployee();
        System.out.println("Full Time Employee Pay: " + emp.calculatePay());

        emp = new PartTimeEmployee();
        System.out.println("Part Time Employee Pay: " + emp.calculatePay());
    }
}

OUTPUT:-

Method Overloading
Addition of two numbers: 30
Addition of three numbers: 60
Addition of decimal numbers: 31.0

Method Overriding
Full Time Employee Pay: 30000.0
Part Time Employee Pay: 15000.0


